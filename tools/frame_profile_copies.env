# The Steam Frame with the guest heap NOT as driver memory: shader global memory through copies of the bound buffers, and the
# VR overlap built on them (exec.c gmir_on, overlap_on). Load after tools/frame_profile.env:
#   set -a; . tools/frame_profile.env; . tools/frame_profile_copies.env; set +a
# The renderer's own default for Turnip is the driver-memory heap (profile one); docs/TECHNICAL.md says copies are the default
# and AGENTS.md says to turn driver memory off when memory runs short, so the Frame is run both ways.
LARECOMP_VK_HEAP_DMABUF=0
LARECOMP_VK_NO_HOST_IMPORT=1
# the overlap is decided by the copies, no page write tracking is asked for
unset LARECOMP_GPU_OVERLAP LARECOMP_OVERLAP_WATCH LARECOMP_SOFT_WRITE_TRACKING LARECOMP_VK_GMEM_LAZY LARECOMP_VK_GMEM_CHUNK_MB
