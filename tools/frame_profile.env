# The Steam Frame's renderer choices (Adreno 750, Mesa Turnip) forced on another GPU, for runs on the desktop:
#   set -a; . tools/frame_profile.env; set +a      then run the game or a tour as usual
# The renderer picks these by GPU vendor or driver (runtime/nvn/vulkan/exec.c vk_exec_init, device.c, docs/vulkan-gpu-defaults.md).
# What the Frame's driver reports comes from its Turnip 26.3 (tools/vkprobe/run.sh --frame, see docs/af/DESKTOP.md): an
# integrated GPU, storage buffers of 128 MB, no VK_EXT_external_memory_host, VK_EXT_map_memory_placed, sparse buffers,
# multiview, 8 px shading-rate texels, D24S8 and fragment-shader subgroups. Settings that do not differ are left out.
# What no switch forces is listed in docs/af/DESKTOP.md.
# On the Frame itself these lines change nothing (they are what it picks anyway).

# Structured shaders (static branch stacks, no jump loop); c1 inlined; hot constant buffer words as push constants
LARECOMP_VK_STRUCTURE=1
LARECOMP_VK_STATIC_STACKS=1
LARECOMP_VK_PUSH_CB=1
LARECOMP_VK_INLINE_C1=1
# The guest heap as driver memory, bound to shaders in 128 MB chunks by device address (Turnip's storage buffer limit),
# no host-memory import
LARECOMP_VK_HEAP_DMABUF=1
LARECOMP_VK_NO_HOST_IMPORT=1
LARECOMP_VK_GMEM_LAZY=1
LARECOMP_VK_GMEM_CHUNK_MB=128
# No page write tracking over that heap (the msm driver maps a refaulted page wrong after a split): the VR overlap
# runs with the hash probe, and the vertex cache is off
LARECOMP_SOFT_WRITE_TRACKING=0
LARECOMP_VK_VCACHE=0
LARECOMP_OVERLAP_WATCH=0
LARECOMP_GPU_OVERLAP=1
# Turnip reports an integrated GPU: lean usage, SMAA stencil, no per-frame target clears, bilinear upscaler default
LARECOMP_INTEGRATED=1
LARECOMP_VK_LEAN_USAGE=1
LARECOMP_VK_SMAA_STENCIL=1
LARECOMP_NO_FRAME_CLEAR=1

# LAS Recomp 0.6's Adreno defaults: Cosmetics recolour as pipeline variants, 1x1x1 compute workgroups packed 64 wide
LARECOMP_VK_TINT_BRANCH=1
LARECOMP_VK_CS_FOLD=1
