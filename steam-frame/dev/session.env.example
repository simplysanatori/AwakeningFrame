# Settings for one launch of AwakeningFrame (Dev): VAR=value lines, read by the launcher (a shell file; $LOGS and $STAMP,
# the log folder and the launch time, can be used). setup-dev-home.sh copies this to session.env once; edit session.env.
# Take a line out with a # in front, put one in by removing it. Change one thing between runs.

# ---- logs, on: plain lines in the run's log files, no work on the GPU, nothing that changes the picture or the timing.
# The pose log is one line per refresh (about 120 a second), a new file per launch, the last 10 kept.
LARECOMP_XR_POSE_LOG=$LOGS/pose-$STAMP.log
LARECOMP_LOG_PACE=1            # one line per game frame: period, CPU, render CPU, GPU time (60 a second)
LARECOMP_VR_EDGE_LOG=1         # one line per frame while Table Edge is on Fade (nothing with Edge off)
LARECOMP_VR_BACKDROP_LOG=1     # a few lines when the Surroundings backdrop is captured
LARECOMP_HUD_LOG=1             # one line in 300 frames about the HUD
# The compositor timing log (vrtiming-<time>.log) is on by default. AF_VRTIMING=0 turns it off.

# ---- A/B switches: off here. Turn on one, play the same spot, turn it off again.
#AF_FDM=0                      # 0: Valve's foveation layer is taken out. 1: left as Steam set it. The log says which.
#AF_THROTTLE=1                 # SteamVR paces the game to every other refresh and makes the second refresh itself
#LARECOMP_VR_CULL_TABLE=1.25,1.5   # the table culling's two sizes (read only by a build that has the culling work)
#LARECOMP_VR_CULL=camera       # the culling follows the camera (default: fit)
#LARECOMP_VR_SCENE=backdrop    # Surroundings: the backdrop
#LARECOMP_VR_HEADROOM=0        # dynamic resolution with the old budget and floor (14.5 ms, 1536 px)

# ---- the owner's own lines from the released entry (the release's session.env is added below when this file is made)
#LARECOMP_VK_HEAP_DMABUF=0     # the guest heap through copies, not driver memory
#LARECOMP_VR_DYNRES=1          # dynamic resolution on
#LARECOMP_XR_QUAD=2.0,1.2      # the HUD panel: distance and width, metres
